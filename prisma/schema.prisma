// ── Konfigurasi Prisma ──────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
  // Output custom dihapus agar menggunakan default Next.js (node_modules/.prisma/client)
  // Ini mencegah error "module not found" saat di-deploy nanti.
}

datasource db {
  provider = "postgresql"
}

// ── Voice-to-Invoice Models ──────────────────────────────────────────────────

model Product {
  id           String        @id @default(cuid())
  nama         String
  namaNormal   String        // lowercase, stripped for fuzzy index
  harga        Int           // dalam Rupiah, integer (tanpa desimal)
  stok         Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  invoiceItems InvoiceItem[]

  @@index([namaNormal])
}

model Invoice {
  id               String        @id @default(cuid())
  nomorInvoice     String        @unique
  tanggalWaktu     DateTime      @default(now()) // Diberi default now() agar otomatis
  transcript       String        @db.Text // Menggunakan Text agar bisa menampung string panjang
  totalKeseluruhan Int
  sessionId        String
  createdAt        DateTime      @default(now())
  items            InvoiceItem[]

  @@index([tanggalWaktu])
  @@index([nomorInvoice])
}

model InvoiceItem {
  id          String     @id @default(cuid())
  // Ditambahkan onDelete: Cascade -> Jika Invoice dihapus, item di dalamnya otomatis terhapus
  invoice     Invoice    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId   String
  product     Product?   @relation(fields: [productId], references: [id])
  productId   String?
  namaBarang  String     // disimpan meskipun produk tidak ditemukan (NOT_FOUND)
  kuantitas   Int
  hargaSatuan Int        // 0 jika NOT_FOUND
  subtotal    Int        // 0 jika NOT_FOUND
  status      ItemStatus

  @@index([invoiceId])
}

enum ItemStatus {
  OK
  NOT_FOUND
  AMBIGUOUS
}

model InvoiceCounter {
  date    String @id // Format: "YYYYMMDD" WIB
  counter Int    @default(0)
}